# Wi-Fi / API / relay settings for the m5stack-llm-ir firmware.
#
# Copy this file to `.env` (same directory) and fill in your own values:
#   cp .env.example .env
#
# `.env` is git-ignored. `firmware/extra_script.py` reads it on every build and
# generates `firmware/include/secrets_generated.h` (also git-ignored), so no
# secrets end up in the source tree or in git.
# Values are plain text after the first '='; do not use inline comments for
# passwords that may contain '#'.

# Wi-Fi (ESP32 supports 2.4 GHz only)
WIFI_SSID=my-home-wifi
WIFI_PASSWORD=my-secret-password

# HTTP API bearer token. Use 32+ random characters, e.g. `openssl rand -hex 32`.
M5IR_API_KEY=0123456789abcdef0123456789abcdef

# Optional Cloudflare Workers reverse tunnel (leave empty to disable).
# RELAY_WS_URL=wss://m5ir-relay.<account>.workers.dev/ws/device
# DEVICE_TOKEN=<the relay's DEVICE_TOKEN secret>
RELAY_WS_URL=
DEVICE_TOKEN=
